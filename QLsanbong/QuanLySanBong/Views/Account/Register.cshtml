@model QuanLySanBong.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Tạo tài khoản";
    Layout = "_Layout";
}

<section class="auth-page">
    <div class="auth-shell auth-shell-register">
        <aside class="auth-visual">
            <div class="auth-visual-copy">
                <a class="auth-back-link" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Về trang chủ</a>
                <span class="auth-kicker"><i class="bi bi-dribbble"></i> SÂN PHỦI 90</span>
                <h1>Thêm đồng đội.<br />Thêm <span>trận hay.</span></h1>
                <p>Tạo tài khoản để lưu thông tin và dễ dàng trở lại với những kèo bóng yêu thích.</p>
                <div class="auth-benefits"><span><i class="bi bi-check-circle-fill"></i> Lưu hồ sơ cá nhân</span><span><i class="bi bi-check-circle-fill"></i> Quản lý tài khoản dễ dàng</span></div>
            </div>
            <div class="auth-photo-caption"><i class="bi bi-geo-alt-fill"></i> Hẹn kèo, gặp nhau trên sân</div>
        </aside>

        <div class="auth-form-panel auth-register-panel">
            <div class="auth-mobile-brand"><span class="brand-ball"><i class="bi bi-dribbble"></i></span><span>SÂN PHỦI <b>90</b></span></div>
            <div class="auth-heading"><span class="eyebrow">THAM GIA CỘNG ĐỒNG</span><h2>Tạo tài khoản</h2><p>Điền thông tin bên dưới để bắt đầu.</p></div>
            <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error"></div>

            <form asp-controller="Account" asp-action="Register" method="post" class="auth-form auth-form-register">
                <div class="auth-field"><label asp-for="HoTen">Họ và tên</label><div class="auth-input-wrap"><i class="bi bi-person"></i><input asp-for="HoTen" autocomplete="name" placeholder="Ví dụ: Nguyễn Văn An" /></div><span asp-validation-for="HoTen" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="TenDangNhap">Tên đăng nhập</label><div class="auth-input-wrap"><i class="bi bi-at"></i><input asp-for="TenDangNhap" autocomplete="username" placeholder="Từ 4 đến 50 ký tự" /></div><span asp-validation-for="TenDangNhap" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="Email">Email</label><div class="auth-input-wrap"><i class="bi bi-envelope"></i><input asp-for="Email" autocomplete="email" placeholder="ban@example.com" /></div><span asp-validation-for="Email" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="SoDienThoai">Số điện thoại</label><div class="auth-input-wrap"><i class="bi bi-telephone"></i><input asp-for="SoDienThoai" autocomplete="tel" placeholder="10 chữ số, bắt đầu bằng 0" /></div><span asp-validation-for="SoDienThoai" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="MatKhau">Mật khẩu</label><div class="auth-input-wrap"><i class="bi bi-lock"></i><input asp-for="MatKhau" type="password" autocomplete="new-password" placeholder="Tạo mật khẩu" /></div><span asp-validation-for="MatKhau" class="auth-field-error"></span></div>
                <div class="auth-field"><label asp-for="NhapLaiMatKhau">Nhập lại mật khẩu</label><div class="auth-input-wrap"><i class="bi bi-shield-lock"></i><input asp-for="NhapLaiMatKhau" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /></div><span asp-validation-for="NhapLaiMatKhau" class="auth-field-error"></span></div>
                <button type="submit" class="auth-submit">Tạo tài khoản <i class="bi bi-arrow-right"></i></button>
            </form>
            <p class="auth-switch">Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></p>
            <div class="auth-help"><i class="bi bi-shield-check"></i> Thông tin của bạn được bảo mật an toàn.</div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

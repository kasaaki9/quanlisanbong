@model QuanLySanBong.ViewModels.DatSanHoanTatViewModel
@{
    ViewData["Title"] = "Đã gửi yêu cầu đặt sân";
}
<section class="booking-done-page"><div class="booking-done-card"><span class="booking-done-icon"><i class="bi bi-check-lg"></i></span><span class="eyebrow">YÊU CẦU ĐÃ ĐƯỢC GỬI</span><h1>Đang chờ sân xác nhận</h1><p>Yêu cầu đặt sân của bạn đã được lưu. Nhân viên sẽ xác nhận lịch và phương thức thanh toán.</p><div class="done-summary"><div><small>Mã phiếu</small><strong>#@Model.MaPhieu.ToString("D6")</strong></div><div><small>Sân</small><strong>@Model.TenSan</strong></div><div><small>Ngày & giờ</small><strong>@Model.NgayDat.ToString("dd/MM/yyyy") · @Model.GioBatDau.ToString(@"hh\:mm") – @Model.GioKetThuc.ToString(@"hh\:mm")</strong></div><div><small>Phương thức</small><strong>@Model.PhuongThuc</strong></div><div><small>Tổng tiền sân</small><strong>@Model.TongTien.ToString("N0") đ</strong></div><div><small>Trạng thái</small><strong class="pending-text">@Model.TrangThai</strong></div></div><div class="done-actions"><a class="button button-primary" asp-controller="Account" asp-action="Profile">Xem tài khoản</a><a class="button button-secondary" asp-controller="Home" asp-action="Index">Về trang chủ</a></div></div></section>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sân Bóng</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="public-header">
        <div class="public-header-inner">
            <a class="public-brand" asp-controller="Home" asp-action="Index">
                <span class="public-brand-mark">S</span>
                <span>SÂN BÓNG</span>
            </a>

            <nav class="public-nav">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a href="/#fields">Chọn sân</a>
                <a href="/#how">Hướng dẫn</a>
            </nav>

            <div class="public-account-links">
                <a class="login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="register-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <span>© @DateTime.Now.Year Quản lý sân bóng</span>
            <span>Đặt sân thuận tiện, nhanh chóng</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model QuanLySanBong.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
    var avatarLetter = string.IsNullOrWhiteSpace(Model.HoTen) ? "U" : Model.HoTen.Trim().Substring(0, 1).ToUpperInvariant();
}

<section class="profile-page">
    <nav class="profile-breadcrumb" aria-label="Điều hướng"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a><i class="bi bi-chevron-right"></i><span>Hồ sơ cá nhân</span></nav>
    @if (TempData["ProfileSuccess"] is string profileSuccess) { <div class="profile-alert success"><i class="bi bi-check-circle-fill"></i> @profileSuccess</div> }

    <section class="profile-hero">
        <div class="profile-hero-copy"><span class="profile-eyebrow"><i class="bi bi-dribbble"></i> SÂN PHỦI 90 · TÀI KHOẢN</span><h1>Chào mừng trở lại,<br /><span>@Model.HoTen</span></h1><p>Quản lý thông tin cá nhân và sẵn sàng cho trận đấu tiếp theo.</p>
            <div class="profile-identity"><span class="profile-avatar">@avatarLetter<i class="bi bi-check-circle-fill"></i></span><span><strong>@Model.HoTen</strong><small>@@@Model.TenDangNhap <b>·</b> @Model.TenVaiTro</small></span></div>
        </div>
        <div class="profile-hero-actions"><a class="profile-action-main" href="/#booking"><i class="bi bi-calendar-plus"></i> Đặt sân ngay</a><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="profile-action-quiet" type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button></form></div>
    </section>

    <div class="profile-content-grid">
        <section class="profile-card profile-details-card"><div class="profile-card-heading"><span class="profile-card-icon"><i class="bi bi-person-vcard"></i></span><div><h2>Thông tin tài khoản</h2><p>Thông tin liên hệ gắn với hồ sơ của bạn.</p></div><div class="profile-card-heading-actions"><span class="profile-status"><i></i> Đang hoạt động</span><a class="profile-edit-button" asp-controller="Account" asp-action="EditProfile"><i class="bi bi-pencil-square"></i> Sửa thông tin</a></div></div>
            <div class="profile-data-grid">
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-person"></i></span><div><small>Họ và tên</small><strong>@Model.HoTen</strong></div></article>
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-at"></i></span><div><small>Tên đăng nhập</small><strong>@Model.TenDangNhap</strong></div></article>
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-envelope"></i></span><div><small>Email</small><strong>@Model.Email</strong></div></article>
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-telephone"></i></span><div><small>Số điện thoại</small><strong>@Model.SoDienThoai</strong></div></article>
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-shield-check"></i></span><div><small>Vai trò</small><strong>@Model.TenVaiTro</strong></div></article>
                <article class="profile-data-item"><span class="profile-data-icon"><i class="bi bi-lock"></i></span><div><small>Mật khẩu</small><strong class="profile-private">Được bảo vệ an toàn <i class="bi bi-check-circle-fill"></i></strong></div></article>
            </div>
        </section>

        <aside class="profile-card profile-help-card"><span class="profile-eyebrow">SẴN SÀNG RA SÂN?</span><h2>Hẹn đồng đội<br />lên kèo thôi!</h2><p>Chọn loại sân và ngày phù hợp để bắt đầu tìm lịch chơi.</p><a href="/#booking" class="profile-help-link">Tìm sân phù hợp <i class="bi bi-arrow-up-right"></i></a><div class="profile-help-divider"></div><a class="profile-support-link" href="tel:0909123456"><i class="bi bi-headset"></i><span><small>Cần hỗ trợ đặt sân?</small><strong>0909 123 456</strong></span></a></aside>
    </div>
</section>

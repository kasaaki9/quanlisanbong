@model QuanLySanBong.ViewModels.DatSanThanhToanViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
<section class="checkout-page"><a class="court-back-link" asp-controller="SanBong" asp-action="ChiTiet" asp-route-id="@Model.MaSan" asp-route-ngay="@Model.NgayDat.ToString("yyyy-MM-dd")"><i class="bi bi-arrow-left"></i> Quay lại chọn giờ</a><div class="checkout-heading"><span class="eyebrow">SÂN PHỦI 90 · THANH TOÁN</span><h1>Xác nhận lượt đặt sân</h1><p>Kiểm tra thông tin sân và chọn cách thanh toán bạn muốn.</p></div>
    @if (!string.IsNullOrWhiteSpace(Model.LoiLich)) { <div class="checkout-error"><i class="bi bi-exclamation-circle"></i> @Model.LoiLich</div> }
    <div class="checkout-grid"><section class="court-panel checkout-panel"><h2>Phương thức thanh toán</h2><p class="checkout-subtitle">Nhân viên sân sẽ xác nhận thanh toán sau khi nhận yêu cầu.</p><form asp-controller="SanBong" asp-action="ThanhToan" method="post" id="checkoutForm">@Html.AntiForgeryToken()<input type="hidden" name="MaSan" value="@Model.MaSan" /><input type="hidden" name="NgayDat" value="@Model.NgayDat.ToString("yyyy-MM-dd")" /><input type="hidden" name="GioBatDau" value="@Model.GioBatDau.ToString(@"hh\:mm")" /><input type="hidden" name="GioKetThuc" value="@Model.GioKetThuc.ToString(@"hh\:mm")" />
        <div class="payment-method-grid">@foreach (var method in Model.PhuongThucs) { <label class="payment-method"><input type="radio" name="PhuongThuc" value="@method" @(method == Model.PhuongThuc ? "checked" : null) /><span class="payment-method-icon"><i class="bi @(method.Contains("chuyển", StringComparison.OrdinalIgnoreCase) ? "bi-bank" : method.Contains("thẻ", StringComparison.OrdinalIgnoreCase) ? "bi-credit-card" : "bi-cash-coin")"></i></span><span><strong>@method</strong><small>@(method.Contains("chuyển", StringComparison.OrdinalIgnoreCase) ? "Chuyển khoản sau khi sân xác nhận" : method.Contains("thẻ", StringComparison.OrdinalIgnoreCase) ? "Thanh toán tại quầy" : "Thanh toán trực tiếp tại sân")</small></span><i class="bi bi-check-circle-fill payment-check"></i></label> }</div>
        <div class="checkout-notice"><i class="bi bi-info-circle"></i><span>Đây là yêu cầu đặt sân. Sân sẽ xác nhận khung giờ và hướng dẫn thanh toán; hệ thống chưa trừ tiền tự động.</span></div><button type="submit" class="button button-primary checkout-submit">Gửi yêu cầu đặt sân <i class="bi bi-arrow-right"></i></button>
    </form></section>
    <aside class="court-panel checkout-summary"><span class="eyebrow">TÓM TẮT ĐẶT SÂN</span><img src="@Model.HinhAnh" alt="@Model.TenSan" /><h2>@Model.TenSan</h2><span class="summary-type">@Model.TenLoaiSan</span><div class="summary-line"><span><i class="bi bi-calendar-event"></i> Ngày chơi</span><strong>@Model.NgayDat.ToString("dd/MM/yyyy")</strong></div><div class="summary-line"><span><i class="bi bi-clock"></i> Khung giờ</span><strong>@Model.GioBatDau.ToString(@"hh\:mm") – @Model.GioKetThuc.ToString(@"hh\:mm")</strong></div><div class="summary-line"><span><i class="bi bi-hourglass"></i> Thời lượng</span><strong>90 phút</strong></div><div class="summary-line"><span>Giá thuê</span><strong>@Model.GiaMoiGio.ToString("N0") đ/giờ</strong></div><div class="summary-total"><span>Tổng cộng</span><strong>@Model.TongTien.ToString("N0") đ</strong></div></aside></div>
</section>


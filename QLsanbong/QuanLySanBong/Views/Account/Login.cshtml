@model QuanLySanBong.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<style>
    .auth-page {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 16px;
        background: #f3f7f4;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        padding: 36px;
        border: 1px solid #e4ebe6;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 14px 40px rgba(24, 59, 43, .10);
    }

    .auth-card h1 {
        margin: 0 0 8px;
        color: #183b2b;
        font-size: 30px;
        font-weight: 750;
    }

    .auth-intro {
        margin-bottom: 24px;
        color: #718078;
    }

    .auth-label {
        display: block;
        margin: 18px 0 7px;
        color: #30483b;
        font-weight: 600;
    }

    .auth-input {
        box-sizing: border-box;
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d5dfd8;
        border-radius: 10px;
        font-size: 15px;
    }

    .auth-input:focus {
        border-color: #16834b;
        outline: 3px solid rgba(22, 131, 75, .12);
    }

    .field-error,
    .validation-summary {
        display: block;
        margin-top: 5px;
        color: #c0392b;
        font-size: 13px;
    }

    .remember-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        color: #53645a;
    }

    .auth-submit {
        width: 100%;
        margin-top: 24px;
        padding: 13px;
        border: 0;
        border-radius: 10px;
        background: #16834b;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
    }

    .auth-submit:hover {
        background: #116b3d;
    }

    .auth-footer {
        margin: 20px 0 0;
        color: #65736b;
        text-align: center;
    }

    .auth-footer a {
        color: #16834b;
        font-weight: 700;
        text-decoration: none;
    }
</style>

<main class="auth-page">
    <section class="auth-card">
        <h1>Đăng nhập</h1>
        <p class="auth-intro">Đăng nhập để tiếp tục đặt sân bóng.</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <label asp-for="TenDangNhap" class="auth-label">
                Tên đăng nhập
            </label>
            <input asp-for="TenDangNhap" class="auth-input"
                   autocomplete="username"
                   placeholder="Nhập tên đăng nhập" />
            <span asp-validation-for="TenDangNhap" class="field-error"></span>

            <label asp-for="MatKhau" class="auth-label">Mật khẩu</label>
            <input asp-for="MatKhau" class="auth-input"
                   autocomplete="current-password"
                   placeholder="Nhập mật khẩu" />
            <span asp-validation-for="MatKhau" class="field-error"></span>

            <label class="remember-row">
                <input asp-for="GhiNhoDangNhap" />
                Ghi nhớ đăng nhập
            </label>

            <button type="submit" class="auth-submit">Đăng nhập</button>
        </form>

        <p class="auth-footer">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
        </p>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
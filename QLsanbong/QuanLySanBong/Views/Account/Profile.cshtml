@model QuanLySanBong.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Tài khoản của tôi";
    Layout = "_Layout";
}

<style>
    .profile-page {
        min-height: 75vh;
        padding: 48px 16px;
        background: #f3f7f4;
    }

    .profile-container {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .profile-heading {
        margin-bottom: 24px;
    }

    .profile-heading h1 {
        margin: 0 0 6px;
        color: #183b2b;
        font-size: 32px;
        font-weight: 750;
    }

    .profile-heading p {
        margin: 0;
        color: #718078;
    }

    .profile-card {
        overflow: hidden;
        border: 1px solid #e2eae4;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 14px 40px rgba(24, 59, 43, .09);
    }

    .profile-banner {
        padding: 28px 32px;
        background: linear-gradient(120deg, #145c38, #23935a);
        color: white;
    }

    .profile-avatar {
        display: grid;
        width: 64px;
        height: 64px;
        margin-bottom: 14px;
        place-items: center;
        border: 2px solid rgba(255, 255, 255, .65);
        border-radius: 50%;
        background: rgba(255, 255, 255, .16);
        font-size: 26px;
        font-weight: 700;
    }

    .profile-banner h2 {
        margin: 0 0 5px;
        font-size: 24px;
    }

    .profile-banner span {
        color: #e0f3e7;
    }

    .profile-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        padding: 30px 32px;
    }

    .profile-field small {
        display: block;
        margin-bottom: 6px;
        color: #718078;
        font-size: 13px;
    }

    .profile-field strong {
        color: #263b30;
        font-size: 16px;
        overflow-wrap: anywhere;
    }

    .profile-actions {
        display: flex;
        gap: 12px;
        padding: 0 32px 30px;
    }

    .profile-button {
        display: inline-block;
        padding: 11px 18px;
        border: 1px solid #16834b;
        border-radius: 9px;
        background: #16834b;
        color: white;
        font-weight: 700;
        text-decoration: none;
    }

    .profile-button:hover {
        background: #116b3d;
        color: white;
    }

    .profile-button-secondary {
        background: white;
        color: #16834b;
    }

    .profile-button-secondary:hover {
        background: #eef7f1;
        color: #116b3d;
    }

    @@media (max-width: 600px) {
        .profile-details {
            grid-template-columns: 1fr;
            padding: 24px;
        }

        .profile-banner {
            padding: 24px;
        }

        .profile-actions {
            flex-direction: column;
            padding: 0 24px 24px;
        }

        .profile-button {
            text-align: center;
        }
    }
</style>

<main class="profile-page">
    <div class="profile-container">
        <header class="profile-heading">
            <h1>Tài khoản của tôi</h1>
            <p>Thông tin tài khoản bạn đã đăng ký.</p>
        </header>

        <section class="profile-card">
            <div class="profile-banner">
                <div class="profile-avatar">
                    @(string.IsNullOrWhiteSpace(Model.HoTen)
                        ? "?"
                        : Model.HoTen.Trim().Substring(0, 1).ToUpper())
                </div>
                <h2>@Model.HoTen</h2>
                <span>@Model.TenVaiTro</span>
            </div>

            <div class="profile-details">
                <div class="profile-field">
                    <small>Tên đăng nhập</small>
                    <strong>@Model.TenDangNhap</strong>
                </div>

                <div class="profile-field">
                    <small>Email</small>
                    <strong>@Model.Email</strong>
                </div>

                <div class="profile-field">
                    <small>Số điện thoại</small>
                    <strong>@Model.SoDienThoai</strong>
                </div>

                <div class="profile-field">
                    <small>Loại tài khoản</small>
                    <strong>@Model.TenVaiTro</strong>
                </div>
            </div>

            <div class="profile-actions">
                <a asp-controller="Home" asp-action="Index"
                   class="profile-button profile-button-secondary">
                    Về trang chủ
                </a>
            </div>
        </section>
    </div>
</main>